[Unit]
Description=Media Core HTTP service (loopback)
Documentation=man:systemd.service(5)
After=network.target

[Service]
Type=simple
User=media-core
Group=media-core
WorkingDirectory=/opt/media-core
ExecStart=/opt/media-core/media-core serve --state-dir /var/lib/media-core --listen 127.0.0.1:8787
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/media-core
UMask=0077

[Install]
WantedBy=multi-user.target
